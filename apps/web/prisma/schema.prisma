generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // "USER" | "ADMIN" | "MODERATOR"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  jobScans      JobScan[]
  reports       Report[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model JobScan {
  id             String    @id // Format: "ck_..." atau unik ID
  userId         String?
  guestSessionId String?
  title          String    // Judul pekerjaan / posisi
  companyName    String?   // Nama perusahaan atau "Tidak tersedia"
  type           String    @default("lowongan") // "lowongan" | "chat"
  riskLevel      String    // "aman" | "waspada" | "bahaya"
  confidence     Float     // 0 - 100
  redFlagCount   Int       @default(0)
  primaryRedFlag String?   // "gaji" | "biaya" | "telegram" | "paspor" | "data"
  imageUrl       String?
  resultJson     Json
  officialCheck  Json?
  scamMatches    Int       @default(0)
  scamDetails    Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime? // null jika akun terdaftar (permanen), atau 24 jam untuk tamu

  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports        Report[]

  @@index([userId])
  @@index([guestSessionId])
  @@index([createdAt])
  @@index([riskLevel])
}

model Report {
  id                  String   @id @default(cuid())
  reportCode          String?  @unique // e.g. "CK-2026-0142"
  scanId              String?
  userId              String?
  jobTitle            String?
  companyName         String?
  type                String   @default("lowongan") // "lowongan" | "chat"
  urgency             String   @default("reguler")  // "darurat_tppo" | "reguler"
  perpetratorContact  String?  // Kontak pelaku (WA / Telegram)
  financialLoss       Float?   // Nominal kerugian
  chronology          String   @db.Text
  evidenceUrl         String?  // URL atau path gambar bukti
  status              String   @default("pending") // pending | approved | rejected
  adminNotes          String?  @db.Text
  reviewedBy          String?
  reviewedAt          DateTime?
  isAnonymous         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  scan                JobScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([urgency])
  @@index([createdAt])
}

model VerifiedScam {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "DB-2026-0001"
  jobTitle    String   // Posisi pekerjaan
  companyName String   // Nama perusahaan fiktif / terduga
  destination String?  // Negara tujuan (Kamboja, Myanmar, Filipina, dll.)
  redFlags    String[] // Array tag red flag
  reportCount Int      @default(1)
  imagePhash  String?  // pHash poster bukti penipuan
  verifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([destination])
  @@index([verifiedAt])
}

model ScamPoster {
  id             String   @id @default(cuid())
  imagePhash     String   // 16 hex chars (64-bit dHash)
  jobTitle       String?
  companyName    String?
  destination    String?
  reportCount    Int      @default(1)
  sourceReportId String?
  verifiedScamId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([imagePhash])
  @@index([createdAt])
}

model OfficialP3MI {
  id             String   @id @default(cuid())
  name           String   // Nama resmi PT P3MI
  normalizedName String   // Nama normalisasi untuk pencarian fuzzy cepat
  licenseNumber  String   // Nomor izin SIP2MI / KEP
  status         String   @default("Aktif") // "Aktif" | "Kedaluwarsa" | "Dibekukan"
  countries      String[] // Daftar negara penempatan resmi
  jobTypes       String[] // Sektor pekerjaan yang diizinkan
  address        String?
  contact        String?
  officialUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([normalizedName])
  @@index([licenseNumber])
}
