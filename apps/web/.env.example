# Database PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cekloker?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="super-secret-key-at-least-32-characters-long"
AUTH_URL="http://localhost:3000"

# Google OAuth (Opsional untuk login Google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Layanan AI (FastAPI microservice)
AI_SERVICE_URL="http://127.0.0.1:8000"

# Penyamaran NIK / nomor rekening pada gambar (OCR lokal, tesseract.js). Opsional.
# Batas waktu OCR per gambar dalam milidetik (bawaan 45000). Naikkan bila server lambat.
# PII_OCR_TIMEOUT_MS=45000
# Bila OCR gagal, bawaannya gambar TIDAK dikirim ke AI (HTTP 503). Isi 1 untuk tetap
# melanjutkan tanpa blur. Hanya untuk darurat, karena data sensitif bisa terkirim ke AI.
# PII_OCR_FAIL_OPEN=0

