# Salin jadi .env lalu isi. JANGAN commit .env ke Git.

# Pilih penyedia: gemini (bawaan) atau openrouter
LLM_PROVIDER=openrouter

# --- OpenRouter (openrouter.ai) ---
OPENROUTER_API_KEY=isi_kunci_dari_openrouter_ai
OPENROUTER_MODEL=google/gemini-3.6-flash
# OPENROUTER_FALLBACK_MODEL=

# --- Gemini langsung (Google AI Studio), dipakai bila LLM_PROVIDER=gemini ---
# GEMINI_API_KEY=isi_kunci_dari_aistudio_google_com
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Pengaturan server API (main.py), semuanya opsional ---
# Kunci rahasia antara backend web dan API ini (kosong = tanpa kunci, hanya untuk lokal).
# Bila diisi, web wajib mengirim header X-API-Key.
# CEKLOKER_API_KEY=buat_string_acak_panjang
# Domain web yang boleh memanggil dari browser, pisahkan koma
# ALLOWED_ORIGINS=http://localhost:3000
# Karena yang memanggil API ini adalah server Next.js, semua pengguna terlihat dari
# satu IP. Naikkan batas per menit untuk demo; batas harian tetap menjaga kredit.
# CEKLOKER_RATE_PER_MIN=10
# CEKLOKER_DAILY_CAP=200
# CEKLOKER_TRUST_PROXY=0
# CEKLOKER_MAX_GAMBAR=3
# CEKLOKER_MAX_MB=10
# CEKLOKER_MAX_TEKS=10000
# CEKLOKER_MAX_SISI=1600
# Cache hasil mentah model di disk, hanya untuk eval (bawaan mati di server)
# CEKLOKER_CACHE=0

# Pembatas opsional OpenRouter agar analisis tidak menggantung (disarankan)
# OPENROUTER_MAX_TOKENS=4000
# OPENROUTER_REASONING=low
