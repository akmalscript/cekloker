# Salin jadi .env lalu isi. JANGAN commit .env ke Git.

# Pilih penyedia: gemini (bawaan) atau openrouter
LLM_PROVIDER=gemini

# --- Gemini langsung (Google AI Studio) ---
GEMINI_API_KEY=isi_kunci_dari_aistudio_google_com
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# GEMINI_EXTRACT_MODEL=gemini-3.5-flash

# --- OpenRouter (openrouter.ai) ---
# OPENROUTER_API_KEY=isi_kunci_dari_openrouter_ai
# Model sama seperti uji kita (berbayar per token):
# OPENROUTER_MODEL=google/gemini-3.6-flash
# Atau model gratis yang bisa membaca gambar (cek daftar terbaru di openrouter.ai/models):
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_EXTRACT_MODEL=
